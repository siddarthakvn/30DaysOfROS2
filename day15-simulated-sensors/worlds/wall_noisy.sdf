<?xml version="1.0" ?>
<!-- Same wall and pose as wall_perfect.sdf, plus Gaussian range noise. -->
<sdf version="1.9">
  <world name="wall_noisy">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="wall">
      <static>true</static>
      <pose>2.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 4.0 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 4.0 1.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.62 1</ambient>
            <diffuse>0.6 0.6 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="lidar_rig">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <sensor name="gpu_lidar" type="gpu_lidar">
          <topic>lidar</topic>
          <update_rate>5</update_rate>
          <always_on>1</always_on>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>32</samples>
                <resolution>1</resolution>
                <min_angle>-0.5</min_angle>
                <max_angle>0.5</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.08</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.05</stddev>
            </noise>
          </lidar>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
