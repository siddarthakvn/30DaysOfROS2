<?xml version="1.0"?>
<!-- Day 13 — mixed tree: fixed joints (/tf_static) and revolute joints (/tf). -->
<robot name="day13_arm">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.12"/></geometry>
    </visual>
  </link>

  <link name="torso">
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry><box size="0.16 0.12 0.40"/></geometry>
    </visual>
  </link>

  <joint name="base_to_torso" type="fixed">
    <parent link="base_link"/>
    <child link="torso"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="upper_arm">
    <visual>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <geometry><box size="0.28 0.06 0.06"/></geometry>
    </visual>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="torso"/>
    <child link="upper_arm"/>
    <origin xyz="0.08 0 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="2"/>
  </joint>

  <link name="forearm">
    <visual>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <geometry><box size="0.24 0.05 0.05"/></geometry>
    </visual>
  </link>

  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0.28 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.4" effort="20" velocity="2"/>
  </joint>

  <link name="hand">
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry><box size="0.08 0.06 0.04"/></geometry>
    </visual>
  </link>

  <!-- Wrist stays fixed: it belongs on /tf_static, not /tf. -->
  <joint name="wrist" type="fixed">
    <parent link="forearm"/>
    <child link="hand"/>
    <origin xyz="0.24 0 0" rpy="0 0 0"/>
  </joint>

</robot>
