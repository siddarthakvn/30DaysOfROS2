<?xml version="1.0"?>
<!-- Day 11 Investigation C — humanoid via Xacro macros (L/R arms). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="day11_humanoid_xacro">

  <xacro:include filename="arm_macro.xacro"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.10" radius="0.18"/>
      </geometry>
      <material name="base_gray">
        <color rgba="0.55 0.55 0.60 1"/>
      </material>
    </visual>
  </link>

  <link name="torso">
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.18 0.50"/>
      </geometry>
      <material name="torso_white">
        <color rgba="0.92 0.92 0.94 1"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_torso" type="fixed">
    <parent link="base_link"/>
    <child link="torso"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- Same macro twice — no copy-paste asymmetry. -->
  <xacro:humanoid_arm prefix="r" parent="torso" reflect="1"/>
  <xacro:humanoid_arm prefix="l" parent="torso" reflect="-1"/>

</robot>
