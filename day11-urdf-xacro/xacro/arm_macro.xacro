<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One arm macro; reflect=+1 right, reflect=-1 left (mirror Y). -->
  <xacro:macro name="humanoid_arm" params="prefix parent reflect:=1">

    <link name="${prefix}_upper_arm">
      <visual>
        <origin xyz="${0.15 * reflect} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.30 0.07 0.07"/>
        </geometry>
        <material name="${prefix}_arm">
          <color rgba="0.25 0.65 0.70 1"/>
        </material>
      </visual>
    </link>

    <joint name="${prefix}_shoulder" type="revolute">
      <parent link="${parent}"/>
      <child link="${prefix}_upper_arm"/>
      <origin xyz="${0.14 * reflect} 0 0.35" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="50" velocity="2.0"/>
    </joint>

    <link name="${prefix}_forearm">
      <visual>
        <origin xyz="${0.14 * reflect} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.28 0.06 0.06"/>
        </geometry>
        <material name="${prefix}_forearm">
          <color rgba="0.20 0.55 0.60 1"/>
        </material>
      </visual>
    </link>

    <joint name="${prefix}_elbow" type="revolute">
      <parent link="${prefix}_upper_arm"/>
      <child link="${prefix}_forearm"/>
      <origin xyz="${0.30 * reflect} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="2.40" effort="40" velocity="2.0"/>
    </joint>

    <link name="${prefix}_hand">
      <visual>
        <origin xyz="${0.05 * reflect} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.10 0.08 0.04"/>
        </geometry>
        <material name="${prefix}_hand">
          <color rgba="0.15 0.15 0.18 1"/>
        </material>
      </visual>
    </link>

    <joint name="${prefix}_wrist" type="fixed">
      <parent link="${prefix}_forearm"/>
      <child link="${prefix}_hand"/>
      <origin xyz="${0.28 * reflect} 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
