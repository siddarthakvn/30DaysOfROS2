<?xml version="1.0"?>
<!-- Day 11 Investigation B — same humanoid, revolute shoulder + elbow. -->
<robot name="day11_humanoid_movable">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.10" radius="0.18"/>
      </geometry>
      <material name="base_gray">
        <color rgba="0.55 0.55 0.60 1"/>
      </material>
    </visual>
  </link>

  <link name="torso">
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.18 0.50"/>
      </geometry>
      <material name="torso_white">
        <color rgba="0.92 0.92 0.94 1"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_torso" type="fixed">
    <parent link="base_link"/>
    <child link="torso"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="r_upper_arm">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.07 0.07"/>
      </geometry>
      <material name="arm_teal">
        <color rgba="0.25 0.65 0.70 1"/>
      </material>
    </visual>
  </link>

  <joint name="r_shoulder" type="revolute">
    <parent link="torso"/>
    <child link="r_upper_arm"/>
    <origin xyz="0.14 0 0.35" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="50" velocity="2.0"/>
  </joint>

  <link name="r_forearm">
    <visual>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.06 0.06"/>
      </geometry>
      <material name="forearm_teal">
        <color rgba="0.20 0.55 0.60 1"/>
      </material>
    </visual>
  </link>

  <joint name="r_elbow" type="revolute">
    <parent link="r_upper_arm"/>
    <child link="r_forearm"/>
    <origin xyz="0.30 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.40" effort="40" velocity="2.0"/>
  </joint>

  <link name="r_hand">
    <visual>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.08 0.04"/>
      </geometry>
      <material name="hand_dark">
        <color rgba="0.15 0.15 0.18 1"/>
      </material>
    </visual>
  </link>

  <joint name="r_wrist" type="fixed">
    <parent link="r_forearm"/>
    <child link="r_hand"/>
    <origin xyz="0.28 0 0" rpy="0 0 0"/>
  </joint>

</robot>
